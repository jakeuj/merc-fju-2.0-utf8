Process
Type            greet_prog
Chance          35
Text
if ispc($n)
  say 嗨﹗你好啊﹗今天又是好天氣說﹗
  hoho $n
endif
~
End

Process
Type            rand_prog
Chance          100
Text
if rand(1)
  say 城內的貓生了五胞胎說﹗真厲害﹗
  break
endif
if rand(1)
  say 昨天城內又有一場婚禮說﹗真是熱鬧呢﹗
  break
endif
if rand(1)
  say 天氣是很好﹗不過遙觀天象似乎有不尋常($2uncommon$0)的事情﹗
  hmm
  break
endif
~
End

Process
Type            speech_prog
Argument        no~
Text
tell $n 喔﹐沒事﹐掰掰﹗
ponder
~
End

End
