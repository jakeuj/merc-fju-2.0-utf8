# MUD PORT 代表執行阜﹐必須大於 1024 ﹐小於 65000﹐最多可以有 5 個

MUD PORT                =       3838
MUD PORT                =       1234
MUD PORT                =       8888

# NAME 代表名稱﹐表示本 MUD 的中文名稱
NAME			=	三國歪傳之降龍伏虎

# 代表錯誤回報的地方
BBS Name                =       [1;33m140.136.196.3 BBS[0m

# 根目錄的實際路徑名稱
HOME DIRECTORY  	=	/home/mud/mud

# IPC KEY 代表申請共享記憶體的門號
IPC KEY                 =       3585

# 共享記憶體﹐要配置幾塊
IPC Block               =       20

# 玩家保留檔案天數﹐以天數為單位﹐至少要 10 天以上
Hold day                =       60

# 玩家檔案限制大小﹐單位是 byte
File Quota              =       150000

# 每秒系統統計幾次函數使用量﹐-1 代表不統計
Prof Cycle              =       -1

# 系統反查詢時所要用的通訊埠
Auth Port               =       113
Finger Port             =       79
Telnet Port             =       23

# 預設玩家的電子郵件信箱
Default Email           =       anonymous@unknow.net

# 預設物品的單位
Default Unit            =       個

# 玩家每增加一歲﹐屬性增加多少﹐小於等於零代表不增加
Increase                =       5

# 玩家超過幾歲後﹐就不再增加上述的屬性﹐小於等於零代表不限制
Increase Limit          =       300

# 共享記憶體閒置多久會被刪除﹐以系統的 Tick 為單位
IPC Idle               =        1000

# MAXDESC 代表最多連線人數﹐最少要 2 個以上﹐上限由程式偵測
MAXDESC			= 	300

# 新玩家註冊最多失誤的機會﹐不能小於等於 3
Max Login Error         =       5

# 定義進入遊戲前最大閒置時間﹐以系統小時為單位
Max Login Idle          =       5

# 定義遊戲最大閒置時間﹐不能小於十﹐以系統小時為單位
Max Playing Idle        =       30

# 定義屍體最大閒置時間﹐不能小於十﹐以系統小時為單位
Max Corpse Idle         =       100

# 定義遊戲中最大執行時間﹐以秒為單位﹐逾時會自動終止遊戲
Max Game Idle           =       300

# GAME LOCK 代表是否鎖定遊戲﹐0 代表否﹐1 代表是
GAME LOCK               =       0

# 是否啟動內部除錯﹐0 代表否﹐1 代表是
Internal Debug          =       1

# TICK PERMIT 代表是否可以使用 tick 這個指令﹐0 代表否﹐1 代表是
TICK PERMIT             =       1

# Multi login 代表是否禁止多重連線﹐0 代表否﹐1 代表是
Multi login             =       0

# 是否檢查對方是否為工作站﹐0 代表否﹐1 代表是
Check Server            =       1

# 是否取得 FQDN﹐0 代表否﹐1 代表是
Get FQDN                =       1

# 是否限制沒有 FQDN 的機器﹐0 代表否﹐1 代表是
FQDN Limit              =       0

# 是否採用周延的密碼方式﹐0 代表否﹐1 代表是
Strict Password         =       1

# 密碼最小長度
Min Password Len        =       5

# 是否採用周延的電子信箱方式﹐0 代表否﹐1 代表是
Strict Email            =       1

# 是否要自動取備份﹐0 代表否﹐1 代表是
Auto Backup             =       0

# 是否同一格族群的人要分享經驗值﹐0 代表否﹐1 代表是﹐預設是 0
GroupSpiltExp           =       0

# 每殺幾隻同種的怪物﹐經驗直會下降一級﹐小於等於0 則不考慮
Mob Decrease            =       0

# 是否在攻擊時﹐玩家可以看到攻傷數值﹐0 代表否﹐1 代表是﹐預設是不要
Attack Value            =       1

# 是否讓玩家看到技能熟練度﹐0 代表否﹐1 代表是﹐預設是不要
Skill Value            =        0

# 是否讓低等級玩家有守護神﹐0 代表否﹐1 代表是﹐預設是要
Player Angel           =        1

# 定義守護神幾級後會自動離開﹐且這段時間 find 怪物也不用錢
