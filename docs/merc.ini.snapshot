# 玩家預設守護期周期, 預設值 60 秒
Angel Default          =        60

# 是否要去設定檔案的屬性﹐0 代表否﹐1 代表是﹐預設是不要
SetFileMode             =       0

# 是否開啟的檔案可以給同一個 group 讀寫﹐0 代表否﹐1 代表是﹐預設是不要
Group Read              =       1
